@{
    ViewData["Title"] = "Página de Inicio";
}

<div class="text-center py-4 mb-5">
    <h1 class="fw-bold display-6 mb-2 text-dark">Bienvenido al SIGEBI</h1>
    <p class="text-secondary fs-5">Sistema de Gestión de Bibliotecas Institucional</p>
</div>

<div class="row g-4 justify-content-center">
    <!-- Módulo 1: Usuarios -->
    <div class="col-md-4 col-lg-2">
        <div class="card-student">
            <div class="icon-box-blue">
                <i class="fa-solid fa-users"></i>
            </div>
            <h5 class="fw-bold fs-6 mb-1 text-dark">Usuarios</h5>
            <p class="text-muted small mb-4">Gestión de usuarios</p>
            <a asp-controller="Usuarios" asp-action="Index" class="btn-blue-outline w-100">Gestión de usuarios</a>
        </div>
    </div>

    <!-- Módulo 2: Catálogo -->
    <div class="col-md-4 col-lg-2">
        <div class="card-student">
            <div class="icon-box-blue">
                <i class="fa-solid fa-book-open"></i>
            </div>
            <h5 class="fw-bold fs-6 mb-1 text-dark">Catálogo</h5>
            <p class="text-muted small mb-4">Gestión de recursos</p>
            <a asp-controller="Recursos" asp-action="Index" class="btn-blue-outline w-100">Gestión de recursos</a>
        </div>
    </div>

    <!-- Módulo 3: Préstamos -->
    <div class="col-md-4 col-lg-2">
        <div class="card-student">
            <div class="icon-box-blue">
                <i class="fa-solid fa-handshake"></i>
            </div>
            <h5 class="fw-bold fs-6 mb-1 text-dark">Préstamos</h5>
            <p class="text-muted small mb-4">Gestión de préstamos</p>
            <a asp-controller="Prestamos" asp-action="Index" class="btn-blue-outline w-100">Gestión de préstamos</a>
        </div>
    </div>

    <!-- Módulo 4: Penalizaciones -->
    <div class="col-md-4 col-lg-2">
        <div class="card-student">
            <div class="icon-box-blue">
                <i class="fa-solid fa-gavel"></i>
            </div>
            <h5 class="fw-bold fs-6 mb-1 text-dark">Penalizaciones</h5>
            <p class="text-muted small mb-4">Gestión de penalizaciones</p>
            <a asp-controller="Penalizaciones" asp-action="Index" class="btn-blue-outline w-100">Gestión de penalizaciones</a>
        </div>
    </div>

    <!-- Módulo 5: Notificaciones -->
    <div class="col-md-4 col-lg-2">
        <div class="card-student">
            <div class="icon-box-blue">
                <i class="fa-solid fa-bell"></i>
            </div>
            <h5 class="fw-bold fs-6 mb-1 text-dark">Notificaciones</h5>
            <p class="text-muted small mb-4">Gestión de notificaciones</p>
            <a asp-controller="Notificaciones" asp-action="Index" class="btn-blue-outline w-100">Gestión de notificaciones</a>
        </div>
    </div>
</div>
