@model SIGEBI.Application.DTOs.NotificacionDto
@{
    ViewData["Title"] = "Editar Notificación";
}

<h3 class="mb-4">Editar Notificación</h3>

<div class="card card-custom p-4 col-md-8 col-lg-6">
    <form asp-action="Editar" asp-route-id="@Model.Id" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label class="form-label font-weight-bold">Usuario ID</label>
            <input asp-for="UsuarioId" type="number" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label font-weight-bold">Tipo</label>
            <input type="text" class="form-control" value="Recordatorio" readonly />
        </div>
        <div class="mb-3">
            <label class="form-label font-weight-bold">Mensaje</label>
            <textarea asp-for="Mensaje" class="form-control" rows="3" required></textarea>
        </div>
        <div class="mb-3">
            <label class="form-label font-weight-bold">Canal</label>
            <input type="text" class="form-control" value="Email" readonly />
        </div>
        <div class="mb-3">
            <label class="form-label font-weight-bold">Fecha de Envío</label>
            <input asp-for="FechaEnvio" type="datetime-local" class="form-control" value="@Model.FechaEnvio.ToString("yyyy-MM-ddTHH:mm")" required />
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary px-4 me-2">Guardar</button>
            <a asp-action="Index" class="btn btn-secondary px-4">Cancelar</a>
        </div>
    </form>
</div>
