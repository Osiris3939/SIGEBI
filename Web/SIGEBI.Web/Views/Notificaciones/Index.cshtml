@model IEnumerable<SIGEBI.Application.DTOs.NotificacionDto>
@{
    ViewData["Title"] = "Listado de Notificaciones";
}

<div class="mb-4">
    <h2 class="fw-bold mb-3">Listado de Notificaciones</h2>
    <a asp-action="Crear" class="link-action">Agregar Nueva Notificación</a>
</div>

<div class="card border rounded-3 p-3 shadow-sm">
    <table class="table-student">
        <thead>
            <tr>
                <th>NOTIFICACIONID</th>
                <th>USUARIOID</th>
                <th>TIPO</th>
                <th>MENSAJE</th>
                <th>ENVIADOEN</th>
                <th>CANAL</th>
                <th>ACCIONES</th>
            </tr>
        </thead>
        <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.UsuarioId</td>
                    <td>Recordatorio</td>
                    <td>@item.Mensaje</td>
                    <td>@item.FechaEnvio.ToString("g")</td>
                    <td>email</td>
                    <td>
                        <a asp-action="Editar" asp-route-id="@item.Id" class="link-action">Editar</a> |
                        <a asp-action="Detalles" asp-route-id="@item.Id" class="link-action">Detalles</a>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>
