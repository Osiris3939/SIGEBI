@model IEnumerable<SIGEBI.Application.DTOs.NotificacionDto>
@{
    ViewData["Title"] = "Listado de Notificaciones";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-extrabold text-dark mb-1"><i class="fa-solid fa-bell text-danger me-2"></i>Centro de Notificaciones</h2>
        <p class="text-secondary small mb-0">Historial de avisos y recordatorios despachados a los usuarios.</p>
    </div>
    <a asp-action="Crear" class="btn btn-primary-custom">
        <i class="fa-solid fa-plus me-2"></i> Enviar Notificación
    </a>
</div>

<div class="card card-custom p-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle table-custom mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>USUARIO</th>
                    <th>MENSAJE</th>
                    <th>FECHA ENVÍO</th>
                    <th>CANAL</th>
                    <th class="text-end">ACCIONES</th>
                </tr>
            </thead>
            <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">#@item.Id</td>
                        <td><i class="fa-solid fa-user text-muted me-1"></i> Usuario #@item.UsuarioId</td>
                        <td class="fw-semibold text-dark">@item.Mensaje</td>
                        <td>@item.FechaEnvio.ToString("yyyy-MM-dd HH:mm")</td>
                        <td><span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-3 py-1 rounded-pill"><i class="fa-solid fa-envelope me-1"></i> Email</span></td>
                        <td class="text-end">
                            <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1"><i class="fa-solid fa-pen me-1"></i> Editar</a>
                            <a asp-action="Detalles" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary"><i class="fa-solid fa-eye me-1"></i> Detalles</a>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
