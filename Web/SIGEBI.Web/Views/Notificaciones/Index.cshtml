@model IEnumerable<SIGEBI.Application.DTOs.NotificacionDto>
@{
    ViewData["Title"] = "Listado de Notificaciones";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Listado de Notificaciones</h2>
</div>

<div class="mb-3">
    <a asp-action="Crear" class="btn btn-outline-primary btn-sm">Agregar Nueva Notificación</a>
</div>

<div class="card card-custom p-3">
    <table class="table table-hover align-middle table-custom mb-0">
        <thead>
            <tr>
                <th>NOTIFICACIONID</th>
                <th>USUARIOID</th>
                <th>TIPO</th>
                <th>MENSAJE</th>
                <th>ENVIADOEN</th>
                <th>CANAL</th>
                <th>ACCIONES</th>
            </tr>
        </thead>
        <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.UsuarioId</td>
                    <td>Recordatorio</td>
                    <td>@item.Mensaje</td>
                    <td>@item.FechaEnvio.ToString("g")</td>
                    <td>email</td>
                    <td>
                        <a asp-action="Editar" asp-route-id="@item.Id" class="btn-action text-primary">Editar</a> |
                        <a asp-action="Detalles" asp-route-id="@item.Id" class="btn-action text-primary">Detalles</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td>1</td>
                <td>3</td>
                <td>Recordatorio</td>
                <td>Devolucion Pendiente para mañana</td>
                <td>7/14/2026 9:57:11 PM</td>
                <td>email</td>
                <td>
                    <a asp-action="Editar" asp-route-id="1" class="btn-action text-primary">Editar</a> |
                    <a asp-action="Detalles" asp-route-id="1" class="btn-action text-primary">Detalles</a>
                </td>
            </tr>
            <tr>
                <td>2</td>
                <td>2</td>
                <td>Recordatorio</td>
                <td>Devolución Pendiente para el Martes</td>
                <td>7/25/2026 12:00:00 AM</td>
                <td>email</td>
                <td>
                    <a asp-action="Editar" asp-route-id="2" class="btn-action text-primary">Editar</a> |
                    <a asp-action="Detalles" asp-route-id="2" class="btn-action text-primary">Detalles</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
