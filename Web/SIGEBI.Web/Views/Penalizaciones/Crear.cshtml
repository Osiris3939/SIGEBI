@model SIGEBI.Application.DTOs.PenalizacionDto
@{
    ViewData["Title"] = "Crear Penalización";
}

<h3 class="mb-4">Crear Penalización</h3>

<div class="card card-custom p-4 col-md-8 col-lg-6">
    <form asp-action="Crear" method="post">
        <div class="mb-3">
            <label class="form-label font-weight-bold">Usuario ID</label>
            <input asp-for="UsuarioId" type="number" class="form-control" value="2" required />
        </div>
        <div class="mb-3">
            <label class="form-label font-weight-bold">Préstamo ID</label>
            <input asp-for="PrestamoId" type="number" class="form-control" value="2" required />
        </div>
        <div class="mb-3">
            <label class="form-label font-weight-bold">Monto</label>
            <input asp-for="MontoMulta" type="number" step="0.01" class="form-control" value="120.00" required />
        </div>
        <div class="mb-3">
            <label class="form-label font-weight-bold">Motivo</label>
            <input asp-for="Motivo" class="form-control" placeholder="Motivo de la multa" value="Retraso de 3 días en la devolución" />
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary px-4 me-2">Crear</button>
            <a asp-action="Index" class="btn btn-secondary px-4">Cancelar</a>
        </div>
    </form>
</div>
