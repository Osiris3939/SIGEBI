@model SIGEBI.Application.DTOs.PenalizacionDto
@{
    ViewData["Title"] = "Detalles de la Penalización";
}

<h3 class="mb-4">Detalles de la Penalización</h3>

<div class="card card-custom p-4 col-md-6">
    <dl class="row mb-0">
        <dt class="col-sm-4 text-muted">ID</dt>
        <dd class="col-sm-8 fw-bold">@Model.Id</dd>

        <dt class="col-sm-4 text-muted">Usuario ID</dt>
        <dd class="col-sm-8">@Model.UsuarioId</dd>

        <dt class="col-sm-4 text-muted">Préstamo ID</dt>
        <dd class="col-sm-8">@Model.PrestamoId</dd>

        <dt class="col-sm-4 text-muted">Monto</dt>
        <dd class="col-sm-8 fw-bold text-danger">RD$ @Model.MontoMulta.ToString("F2")</dd>

        <dt class="col-sm-4 text-muted">Motivo</dt>
        <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Motivo) ? "Retraso en entrega" : Model.Motivo)</dd>

        <dt class="col-sm-4 text-muted">Estado</dt>
        <dd class="col-sm-8"><span class="badge @(Model.Pagada ? "bg-success" : "bg-warning text-dark")">@(Model.Pagada ? "Pagada" : "Pendiente")</span></dd>
    </dl>

    <div class="mt-4">
        <a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-primary btn-sm px-3 me-2">Editar</a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm px-3">Volver al listado</a>
    </div>
</div>
