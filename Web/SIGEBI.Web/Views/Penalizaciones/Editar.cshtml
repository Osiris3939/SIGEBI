@model SIGEBI.Application.DTOs.PenalizacionDto
@{
    ViewData["Title"] = "Editar Penalización";
}

<h3 class="mb-4">Editar Penalización</h3>

<div class="card card-custom p-4 col-md-8 col-lg-6">
    <form asp-action="Editar" asp-route-id="@Model.Id" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label class="form-label font-weight-bold">Usuario ID</label>
            <input asp-for="UsuarioId" type="number" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label font-weight-bold">Préstamo ID</label>
            <input asp-for="PrestamoId" type="number" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label font-weight-bold">Monto</label>
            <input asp-for="MontoMulta" type="number" step="0.01" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label font-weight-bold">Motivo</label>
            <input asp-for="Motivo" class="form-control" />
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary px-4 me-2">Guardar</button>
            <a asp-action="Index" class="btn btn-secondary px-4">Cancelar</a>
        </div>
    </form>
</div>
