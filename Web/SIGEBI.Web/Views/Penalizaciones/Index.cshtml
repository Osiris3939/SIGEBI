@model IEnumerable<SIGEBI.Application.DTOs.PenalizacionDto>
@{
    ViewData["Title"] = "Listado de Penalizaciones";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Listado de Penalizaciones</h2>
</div>

<div class="mb-3">
    <a asp-action="Crear" class="btn btn-outline-primary btn-sm">Agregar Nueva Penalización</a>
</div>

<div class="card card-custom p-3">
    <table class="table table-hover align-middle table-custom mb-0">
        <thead>
            <tr>
                <th>PENALIZACIONID</th>
                <th>USUARIOID</th>
                <th>PRESTAMOID</th>
                <th>MONTO</th>
                <th>ESTADO</th>
                <th>FECHAEMISION</th>
                <th>ACCIONES</th>
            </tr>
        </thead>
        <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.UsuarioId</td>
                    <td>@item.PrestamoId</td>
                    <td>RD$ @item.MontoMulta.ToString("F2")</td>
                    <td><span class="badge @(item.Pagada ? "bg-success" : "bg-warning text-dark")">@(item.Pagada ? "Pagada" : "Pendiente")</span></td>
                    <td>7/14/2026 9:55:36 PM</td>
                    <td>
                        <a asp-action="Editar" asp-route-id="@item.Id" class="btn-action text-primary">Editar</a> |
                        <a asp-action="Detalles" asp-route-id="@item.Id" class="btn-action text-primary">Detalles</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td>1</td>
                <td>3</td>
                <td>1</td>
                <td>50.00</td>
                <td><span class="badge bg-warning text-dark">Pendiente</span></td>
                <td>7/14/2026 9:55:36 PM</td>
                <td>
                    <a asp-action="Editar" asp-route-id="1" class="btn-action text-primary">Editar</a> |
                    <a asp-action="Detalles" asp-route-id="1" class="btn-action text-primary">Detalles</a>
                </td>
            </tr>
            <tr>
                <td>2</td>
                <td>2</td>
                <td>2</td>
                <td>120.00</td>
                <td><span class="badge bg-warning text-dark">Pendiente</span></td>
                <td>7/25/2026 12:00:00 AM</td>
                <td>
                    <a asp-action="Editar" asp-route-id="2" class="btn-action text-primary">Editar</a> |
                    <a asp-action="Detalles" asp-route-id="2" class="btn-action text-primary">Detalles</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
