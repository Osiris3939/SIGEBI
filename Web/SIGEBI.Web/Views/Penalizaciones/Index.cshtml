@model IEnumerable<SIGEBI.Application.DTOs.PenalizacionDto>
@{
    ViewData["Title"] = "Listado de Penalizaciones";
}

<div class="mb-4">
    <h2 class="fw-bold mb-3">Listado de Penalizaciones</h2>
    <a asp-action="Crear" class="link-action">Agregar Nueva Penalización</a>
</div>

<div class="card border rounded-3 p-3 shadow-sm">
    <table class="table-student">
        <thead>
            <tr>
                <th>PENALIZACIONID</th>
                <th>USUARIOID</th>
                <th>PRESTAMOID</th>
                <th>MONTO</th>
                <th>ESTADO</th>
                <th>FECHAEMISION</th>
                <th>ACCIONES</th>
            </tr>
        </thead>
        <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.UsuarioId</td>
                    <td>@item.PrestamoId</td>
                    <td>@item.MontoMulta.ToString("F2")</td>
                    <td>@(item.Pagada ? "Pagada" : "Pendiente")</td>
                    <td>7/14/2026 9:55:36 PM</td>
                    <td>
                        <a asp-action="Editar" asp-route-id="@item.Id" class="link-action">Editar</a> |
                        <a asp-action="Detalles" asp-route-id="@item.Id" class="link-action">Detalles</a>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>
