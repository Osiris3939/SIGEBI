@model IEnumerable<SIGEBI.Application.DTOs.PrestamoDto>
@{
    ViewData["Title"] = "Listado de Préstamos";
}

<div class="d-flex justify-content-between align-items-center mb-4" data-aos="fade-down">
    <div>
        <h2 class="font-serif fw-bold text-dark mb-1"><i class="fa-solid fa-handshake text-warning me-2"></i>Gestión de Préstamos</h2>
        <p class="text-muted small mb-0">Control de salidas de ejemplares y fechas pactadas de devolución.</p>
    </div>
    <a asp-action="Crear" class="btn-gold-action">
        <i class="fa-solid fa-plus me-2"></i> Registrar Préstamo
    </a>
</div>

<div class="card-lib p-4" data-aos="fade-up">
    <div class="table-responsive">
        <table class="table-lib">
            <thead>
                <tr>
                    <th>PRESTAMOID</th>
                    <th>USUARIO</th>
                    <th>EJEMPLAR</th>
                    <th>FECHA PRÉSTAMO</th>
                    <th>DEVOLUCIÓN PACTADA</th>
                    <th>ESTADO</th>
                    <th class="text-end">ACCIONES</th>
                </tr>
            </thead>
            <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold text-muted">#@item.Id</td>
                        <td><i class="fa-solid fa-user text-muted me-1"></i> Usuario #@item.UsuarioId</td>
                        <td><i class="fa-solid fa-book text-muted me-1"></i> Ejemplar #@item.EjemplarId</td>
                        <td>@item.FechaPrestamo.ToString("yyyy-MM-dd HH:mm")</td>
                        <td><span class="text-primary fw-bold">@item.FechaDevolucionPactada.ToString("yyyy-MM-dd HH:mm")</span></td>
                        <td><span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-3 py-2 rounded-pill"><i class="fa-solid fa-clock me-1"></i> @item.EstadoPrestamo</span></td>
                        <td class="text-end">
                            <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1"><i class="fa-solid fa-pen me-1"></i> Editar</a>
                            <a asp-action="Detalles" asp-route-id="@item.Id" class="btn btn-sm btn-navy-outline"><i class="fa-solid fa-eye me-1"></i> Detalles</a>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
