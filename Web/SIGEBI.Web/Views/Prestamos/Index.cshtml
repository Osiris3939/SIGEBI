@model IEnumerable<SIGEBI.Application.DTOs.PrestamoDto>
@{
    ViewData["Title"] = "Listado de Préstamos";
}

<div class="mb-4">
    <h2 class="fw-bold mb-3">Listado de Préstamos</h2>
    <a asp-action="Crear" class="link-action">Agregar Nuevo Préstamo</a>
</div>

<div class="card border rounded-3 p-3 shadow-sm">
    <table class="table-student">
        <thead>
            <tr>
                <th>PRESTAMOID</th>
                <th>USUARIOID</th>
                <th>EJEMPLARID</th>
                <th>FECHAPRESTAMO</th>
                <th>FECHADEVOLUCIONESPERADA</th>
                <th>ESTADO</th>
                <th>ACCIONES</th>
            </tr>
        </thead>
        <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.UsuarioId</td>
                    <td>@item.EjemplarId</td>
                    <td>@item.FechaPrestamo.ToString("g")</td>
                    <td>@item.FechaDevolucionPactada.ToString("g")</td>
                    <td>@item.EstadoPrestamo</td>
                    <td>
                        <a asp-action="Editar" asp-route-id="@item.Id" class="link-action">Editar</a> |
                        <a asp-action="Detalles" asp-route-id="@item.Id" class="link-action">Detalles</a>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>
