@model IEnumerable<SIGEBI.Application.DTOs.PrestamoDto>
@{
    ViewData["Title"] = "Listado de Préstamos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Listado de Préstamos</h2>
</div>

<div class="mb-3">
    <a asp-action="Crear" class="btn btn-outline-primary btn-sm">Agregar Nuevo Préstamo</a>
</div>

<div class="card card-custom p-3">
    <table class="table table-hover align-middle table-custom mb-0">
        <thead>
            <tr>
                <th>PRESTAMOID</th>
                <th>USUARIOID</th>
                <th>EJEMPLARID</th>
                <th>FECHAPRESTAMO</th>
                <th>FECHADEVOLUCIONESPERADA</th>
                <th>ESTADO</th>
                <th>ACCIONES</th>
            </tr>
        </thead>
        <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.UsuarioId</td>
                    <td>@item.EjemplarId</td>
                    <td>@item.FechaPrestamo.ToString("g")</td>
                    <td>@item.FechaDevolucionPactada.ToString("g")</td>
                    <td><span class="badge bg-primary">@item.EstadoPrestamo</span></td>
                    <td>
                        <a asp-action="Editar" asp-route-id="@item.Id" class="btn-action text-primary">Editar</a> |
                        <a asp-action="Detalles" asp-route-id="@item.Id" class="btn-action text-primary">Detalles</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td>1</td>
                <td>3</td>
                <td>1</td>
                <td>7/14/2026 9:53:37 PM</td>
                <td>7/20/2026 9:53:37 PM</td>
                <td><span class="badge bg-primary">Activo</span></td>
                <td>
                    <a asp-action="Editar" asp-route-id="1" class="btn-action text-primary">Editar</a> |
                    <a asp-action="Detalles" asp-route-id="1" class="btn-action text-primary">Detalles</a>
                </td>
            </tr>
            <tr>
                <td>2</td>
                <td>3</td>
                <td>2</td>
                <td>7/24/2026 11:35:00 PM</td>
                <td>7/30/2026 2:35:00 PM</td>
                <td><span class="badge bg-primary">Activo</span></td>
                <td>
                    <a asp-action="Editar" asp-route-id="2" class="btn-action text-primary">Editar</a> |
                    <a asp-action="Detalles" asp-route-id="2" class="btn-action text-primary">Detalles</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
