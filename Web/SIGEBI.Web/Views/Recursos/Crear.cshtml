@model SIGEBI.Application.DTOs.RecursoBibliograficoDto
@{
    ViewData["Title"] = "Crear Recurso";
}

<h3 class="mb-4">Crear Recurso</h3>

<div class="card card-custom p-4 col-md-8 col-lg-6">
    <form asp-action="Crear" method="post">
        <div class="mb-3">
            <label class="form-label font-weight-bold">Título</label>
            <input asp-for="Titulo" class="form-control" placeholder="Título del libro" required />
        </div>
        <div class="mb-3">
            <label class="form-label font-weight-bold">Autor</label>
            <input asp-for="Autor" class="form-control" placeholder="Nombre del autor" required />
        </div>
        <div class="mb-3">
            <label class="form-label font-weight-bold">Editorial</label>
            <input asp-for="Editorial" class="form-control" placeholder="Nombre de la editorial" required />
        </div>
        <div class="mb-3">
            <label class="form-label font-weight-bold">Año Publicación</label>
            <input asp-for="AnioPublicacion" type="number" class="form-control" value="2024" required />
        </div>
        <div class="mb-3">
            <label class="form-label font-weight-bold">Categoría ID</label>
            <input asp-for="CategoriaId" type="number" class="form-control" value="1" required />
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary px-4 me-2">Crear</button>
            <a asp-action="Index" class="btn btn-secondary px-4">Cancelar</a>
        </div>
    </form>
</div>
