@model IEnumerable<SIGEBI.Application.DTOs.RecursoBibliograficoDto>
@{
    ViewData["Title"] = "Catálogo de Recursos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Catálogo de Recursos</h2>
</div>

<div class="mb-3">
    <a asp-action="Crear" class="btn btn-outline-primary btn-sm">Agregar Nuevo Recurso</a>
</div>

<div class="card card-custom p-3">
    <table class="table table-hover align-middle table-custom mb-0">
        <thead>
            <tr>
                <th>RECURSOID</th>
                <th>TITULO</th>
                <th>AUTOR</th>
                <th>EDITORIAL</th>
                <th>AÑO</th>
                <th>ACCIONES</th>
            </tr>
        </thead>
        <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Titulo</td>
                    <td>@item.Autor</td>
                    <td>@item.Editorial</td>
                    <td>@item.AnioPublicacion</td>
                    <td>
                        <a asp-action="Editar" asp-route-id="@item.Id" class="btn-action text-primary">Editar</a> |
                        <a asp-action="Detalles" asp-route-id="@item.Id" class="btn-action text-primary">Detalles</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td>1</td>
                <td>El Principito (Edición Especial)</td>
                <td>Antoine de Saint-Exupéry</td>
                <td>Literatura</td>
                <td>2020</td>
                <td>
                    <a asp-action="Editar" asp-route-id="1" class="btn-action text-primary">Editar</a> |
                    <a asp-action="Detalles" asp-route-id="1" class="btn-action text-primary">Detalles</a>
                </td>
            </tr>
            <tr>
                <td>2</td>
                <td>Cien años de soledad</td>
                <td>Gabriel García Márquez</td>
                <td>Novela literaria</td>
                <td>2019</td>
                <td>
                    <a asp-action="Editar" asp-route-id="2" class="btn-action text-primary">Editar</a> |
                    <a asp-action="Detalles" asp-route-id="2" class="btn-action text-primary">Detalles</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
