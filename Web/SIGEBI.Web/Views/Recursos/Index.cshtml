@model IEnumerable<SIGEBI.Application.DTOs.RecursoBibliograficoDto>
@{
    ViewData["Title"] = "Catálogo de Recursos";
}

<div class="d-flex justify-content-between align-items-center mb-4" data-aos="fade-down">
    <div>
        <h2 class="font-serif fw-bold text-dark mb-1"><i class="fa-solid fa-book-open text-warning me-2"></i>Catálogo de Recursos Bibliográficos</h2>
        <p class="text-muted small mb-0">Colección de libros y ejemplares físicos disponibles en la biblioteca.</p>
    </div>
    <a asp-action="Crear" class="btn-gold-action">
        <i class="fa-solid fa-plus me-2"></i> Agregar Nuevo Recurso
    </a>
</div>

<!-- Galería de Portadas con las Imágenes Reales del Usuario -->
<div class="row g-4 mb-5">
@if (Model != null && Model.Any())
{
    int delay = 100;
    foreach (var item in Model)
    {
        <div class="col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="@delay">
            <div class="card-lib h-100 d-flex flex-column">
                <div class="book-cover-wrapper">
                    <img src="@item.ImagenUrl" class="book-cover-img" alt="@item.Titulo" />
                    <span class="book-badge">Categoría #@item.CategoriaId</span>
                </div>
                <div class="p-4 d-flex flex-column flex-grow-1 justify-content-between">
                    <div>
                        <h5 class="font-serif fw-bold text-dark mb-1">@item.Titulo</h5>
                        <p class="text-muted small mb-2"><i class="fa-solid fa-feather me-1 text-warning"></i> @item.Autor</p>
                        <p class="text-secondary small mb-3"><strong>Editorial:</strong> @item.Editorial | <strong>Año:</strong> @item.AnioPublicacion</p>
                    </div>
                    <div class="pt-3 border-top d-flex justify-content-between align-items-center">
                        <span class="badge bg-secondary bg-opacity-10 text-secondary border">Disponible</span>
                        <div>
                            <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1"><i class="fa-solid fa-pen"></i> Editar</a>
                            <a asp-action="Detalles" asp-route-id="@item.Id" class="btn btn-sm btn-navy-outline"><i class="fa-solid fa-eye"></i> Detalles</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        delay += 100;
    }
}
</div>

<!-- Tabla Académica Integrada -->
<div class="card-lib p-4" data-aos="fade-up">
    <h5 class="font-serif fw-bold mb-3"><i class="fa-solid fa-table me-2 text-warning"></i>Listado Detallado de Recursos</h5>
    <div class="table-responsive">
        <table class="table-lib">
            <thead>
                <tr>
                    <th>RECURSOID</th>
                    <th>TITULO</th>
                    <th>AUTOR</th>
                    <th>EDITORIAL</th>
                    <th>AÑO</th>
                    <th class="text-end">ACCIONES</th>
                </tr>
            </thead>
            <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold text-muted">#@item.Id</td>
                        <td class="fw-bold text-dark font-serif">@item.Titulo</td>
                        <td>@item.Autor</td>
                        <td>@item.Editorial</td>
                        <td>@item.AnioPublicacion</td>
                        <td class="text-end">
                            <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">Editar</a>
                            <a asp-action="Detalles" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Detalles</a>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
