@model IEnumerable<SIGEBI.Application.DTOs.RecursoBibliograficoDto>
@{
    ViewData["Title"] = "Catálogo de Recursos";
}

<div class="mb-4">
    <h2 class="fw-bold mb-3">Catálogo de Recursos</h2>
    <a asp-action="Crear" class="link-action">Agregar Nuevo Recurso</a>
</div>

<!-- Vista de Galería de Libros con Fotografía Real -->
<div class="row g-4 mb-5">
@if (Model != null && Model.Any())
{
    foreach (var item in Model)
    {
        <div class="col-md-6 col-lg-3">
            <div class="card h-100 border rounded-3 shadow-sm overflow-hidden">
                <div style="height: 220px; overflow: hidden; background-color: #f8f9fa;" class="d-flex align-items-center justify-content-center border-bottom">
                    <img src="@(string.IsNullOrEmpty(item.ImagenUrl) ? "/images/don_quijote.jpg" : item.ImagenUrl)" style="width: 100%; height: 100%; object-fit: cover;" alt="@item.Titulo" />
                </div>
                <div class="card-body p-3 d-flex flex-column justify-content-between">
                    <div>
                        <h6 class="fw-bold mb-1 text-dark">@item.Titulo</h6>
                        <p class="text-secondary small mb-2">Autor: @item.Autor</p>
                        <p class="text-muted small mb-2">Año: @item.AnioPublicacion | Editorial: @item.Editorial</p>
                    </div>
                    <div class="pt-2 border-top">
                        <a asp-action="Editar" asp-route-id="@item.Id" class="link-action me-2">Editar</a> |
                        <a asp-action="Detalles" asp-route-id="@item.Id" class="link-action ms-1">Detalles</a>
                    </div>
                </div>
            </div>
        </div>
    }
}
</div>

<!-- Tabla del Catálogo de Recursos -->
<div class="card border rounded-3 p-3 shadow-sm">
    <table class="table-student">
        <thead>
            <tr>
                <th>RECURSOID</th>
                <th>TITULO</th>
                <th>AUTOR</th>
                <th>EDITORIAL</th>
                <th>AÑO</th>
                <th>ACCIONES</th>
            </tr>
        </thead>
        <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td class="fw-medium">@item.Titulo</td>
                    <td>@item.Autor</td>
                    <td>@item.Editorial</td>
                    <td>@item.AnioPublicacion</td>
                    <td>
                        <a asp-action="Editar" asp-route-id="@item.Id" class="link-action">Editar</a> |
                        <a asp-action="Detalles" asp-route-id="@item.Id" class="link-action">Detalles</a>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>
