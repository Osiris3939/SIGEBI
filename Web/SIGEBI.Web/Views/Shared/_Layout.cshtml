<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SIGEBI - Sistema de Gestión de Bibliotecas</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        .navbar-brand {
            font-weight: 700;
            font-size: 1.4rem;
            color: #1a252f !important;
        }
        .nav-link {
            font-weight: 500;
            color: #495057 !important;
            margin-right: 15px;
        }
        .nav-link:hover, .nav-link.active {
            color: #0d6efd !important;
            font-weight: 600;
        }
        .card-custom {
            border: 1px solid #e9ecef;
            border-radius: 12px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.04);
            background: #ffffff;
            transition: transform 0.2s ease;
        }
        .card-custom:hover {
            transform: translateY(-3px);
        }
        .table-custom th {
            background-color: #f1f3f5;
            color: #495057;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .btn-action {
            font-size: 0.85rem;
            text-decoration: none;
            margin-right: 5px;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm mb-4">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">SIGEBI</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Usuarios" asp-action="Index">Usuarios</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Recursos" asp-action="Index">Catálogo</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Prestamos" asp-action="Index">Préstamos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Penalizaciones" asp-action="Index">Penalizaciones</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Notificaciones" asp-action="Index">Notificaciones</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container mb-5">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted bg-white py-3 mt-auto fixed-bottom">
        <div class="container text-center">
            &copy; 2026 - SIGEBI (Sistema de Gestión de Bibliotecas) - ITLA Programación 2
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
