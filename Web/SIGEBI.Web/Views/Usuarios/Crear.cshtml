@model SIGEBI.Application.DTOs.UsuarioDto
@{
    ViewData["Title"] = "Crear Usuario";
}

<h3 class="mb-4">Crear Usuario</h3>

<div class="card card-custom p-4 col-md-8 col-lg-6">
    <form asp-action="Crear" method="post">
        <div class="mb-3">
            <label class="form-label font-weight-bold">Nombre</label>
            <input asp-for="Nombre" class="form-control" placeholder="Ingrese nombre" required />
        </div>
        <div class="mb-3">
            <label class="form-label font-weight-bold">Apellido</label>
            <input asp-for="Apellido" class="form-control" placeholder="Ingrese apellido" required />
        </div>
        <div class="mb-3">
            <label class="form-label font-weight-bold">Email</label>
            <input asp-for="Correo" type="email" class="form-control" placeholder="usuario@gmail.com" required />
        </div>
        <div class="mb-3">
            <label class="form-label font-weight-bold">Contraseña</label>
            <input asp-for="Password" type="password" class="form-control" placeholder="********" required />
        </div>
        <div class="mb-3">
            <label class="form-label font-weight-bold">Rol ID</label>
            <input asp-for="RolUsuarioId" type="number" class="form-control" value="2" required />
        </div>
        <div class="mb-3">
            <label class="form-label font-weight-bold">Tipo Usuario ID</label>
            <input asp-for="TipoUsuarioId" type="number" class="form-control" value="1" required />
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary px-4 me-2">Crear</button>
            <a asp-action="Index" class="btn btn-secondary px-4">Cancelar</a>
        </div>
    </form>
</div>
