@model SIGEBI.Application.DTOs.UsuarioDto
@{
    ViewData["Title"] = "Editar Usuario";
}

<h3 class="mb-4">Editar Usuario</h3>

<div class="card card-custom p-4 col-md-8 col-lg-6">
    <form asp-action="Editar" asp-route-id="@Model.Id" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label class="form-label font-weight-bold">Nombre</label>
            <input asp-for="Nombre" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label font-weight-bold">Apellido</label>
            <input asp-for="Apellido" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label font-weight-bold">Email</label>
            <input asp-for="Correo" type="email" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label font-weight-bold">Rol ID</label>
            <input asp-for="RolUsuarioId" type="number" class="form-control" required />
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary px-4 me-2">Guardar</button>
            <a asp-action="Index" class="btn btn-secondary px-4">Cancelar</a>
        </div>
    </form>
</div>
