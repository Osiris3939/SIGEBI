@model IEnumerable<SIGEBI.Application.DTOs.UsuarioDto>
@{
    ViewData["Title"] = "Listado de Usuarios";
}

<div class="d-flex justify-content-between align-items-center mb-4" data-aos="fade-down">
    <div>
        <h2 class="font-serif fw-bold text-dark mb-1"><i class="fa-solid fa-users text-warning me-2"></i>Gestión de Usuarios</h2>
        <p class="text-muted small mb-0">Directorio de miembros y cuentas de usuario registradas.</p>
    </div>
    <a asp-action="Crear" class="btn-gold-action">
        <i class="fa-solid fa-user-plus me-2"></i> Agregar Nuevo Usuario
    </a>
</div>

<div class="card-lib p-4" data-aos="fade-up">
    <div class="table-responsive">
        <table class="table-lib">
            <thead>
                <tr>
                    <th>USUARIOID</th>
                    <th>NOMBRE COMPLETO</th>
                    <th>EMAIL</th>
                    <th>ESTADO</th>
                    <th>ROL ID</th>
                    <th class="text-end">ACCIONES</th>
                </tr>
            </thead>
            <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold text-muted">#@item.Id</td>
                        <td class="fw-bold text-dark">@item.NombreCompleto</td>
                        <td>@item.Correo</td>
                        <td><span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 rounded-pill"><i class="fa-solid fa-check me-1"></i> Activo</span></td>
                        <td><span class="badge bg-secondary bg-opacity-10 text-secondary border">Rol #@item.RolUsuarioId</span></td>
                        <td class="text-end">
                            <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1"><i class="fa-solid fa-pen me-1"></i> Editar</a>
                            <a asp-action="Detalles" asp-route-id="@item.Id" class="btn btn-sm btn-navy-outline"><i class="fa-solid fa-eye me-1"></i> Detalles</a>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
