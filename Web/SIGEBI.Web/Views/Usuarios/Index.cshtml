@model IEnumerable<SIGEBI.Application.DTOs.UsuarioDto>
@{
    ViewData["Title"] = "Listado de Usuarios";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-extrabold text-dark mb-1"><i class="fa-solid fa-users text-primary me-2"></i>Gestión de Usuarios</h2>
        <p class="text-secondary small mb-0">Directorio de miembros y cuentas de usuario registradas.</p>
    </div>
    <a asp-action="Crear" class="btn btn-primary-custom">
        <i class="fa-solid fa-user-plus me-2"></i> Registrar Usuario
    </a>
</div>

<div class="card card-custom p-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle table-custom mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>USUARIO</th>
                    <th>EMAIL</th>
                    <th>ESTADO</th>
                    <th>ROL</th>
                    <th class="text-end">ACCIONES</th>
                </tr>
            </thead>
            <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-bold">#@item.Id</td>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-2 px-3 fw-bold">
                                    <i class="fa-solid fa-user"></i>
                                </div>
                                <div>
                                    <h6 class="mb-0 fw-bold">@item.NombreCompleto</h6>
                                    <small class="text-muted">Tipo Usuario #@item.TipoUsuarioId</small>
                                </div>
                            </div>
                        </td>
                        <td>@item.Correo</td>
                        <td><span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 rounded-pill"><i class="fa-solid fa-circle-check me-1"></i> Activo</span></td>
                        <td><span class="badge bg-secondary bg-opacity-10 text-secondary border px-2 py-1">Rol #@item.RolUsuarioId</span></td>
                        <td class="text-end">
                            <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1"><i class="fa-solid fa-pen me-1"></i> Editar</a>
                            <a asp-action="Detalles" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary"><i class="fa-solid fa-eye me-1"></i> Detalles</a>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>
