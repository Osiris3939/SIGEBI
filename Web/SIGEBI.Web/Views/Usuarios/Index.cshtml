@model IEnumerable<SIGEBI.Application.DTOs.UsuarioDto>
@{
    ViewData["Title"] = "Listado de Usuarios";
}

<div class="mb-4">
    <h2 class="fw-bold mb-3">Listado de Usuarios</h2>
    <a asp-action="Crear" class="link-action">Agregar Nuevo</a>
</div>

<div class="card border rounded-3 p-3 shadow-sm">
    <table class="table-student">
        <thead>
            <tr>
                <th>USUARIOID</th>
                <th>NOMBRECOMPLETO</th>
                <th>EMAIL</th>
                <th>ESTAACTIVO</th>
                <th>ROLID</th>
                <th>ACCIONES</th>
            </tr>
        </thead>
        <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.NombreCompleto</td>
                    <td>@item.Correo</td>
                    <td><input type="checkbox" checked disabled class="form-check-input" /></td>
                    <td>@item.RolUsuarioId</td>
                    <td>
                        <a asp-action="Editar" asp-route-id="@item.Id" class="link-action">Editar</a> |
                        <a asp-action="Detalles" asp-route-id="@item.Id" class="link-action">Detalles</a>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</div>
